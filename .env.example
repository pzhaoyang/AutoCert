# auto_cert.sh 配置
# 复制为 .env 后 chmod 600，切勿提交到仓库
#   cp .env.example .env && chmod 600 .env
#
# 从 Windows 拷过来的话先转一下换行：
#   dos2unix .env

# ============ 必填 ============

# 域名列表：写多少签多少，脚本不做任何自动补全。
# 逗号、分号、空格、换行都可以作分隔符，会自动去重。
#
#   CERT_DOMAINS="a.com"                   → 只签 a.com
#   CERT_DOMAINS="a.com,*.a.com"           → a.com 和 *.a.com
#   CERT_DOMAINS="a.com,b.com,*.a.com"     → 三个都要
#
# 注意：*.a.com 不覆盖 a.com 本身（RFC 6125），
#       需要裸域名就一起写上，否则脚本会告警提醒。
CERT_DOMAINS="your.domain,*.your.domain"

# DNS 验证方式：dns_cf（Cloudflare）| dns_dp（DNSPod）
# 凭据要求由它决定，见下方 CF_Token / DP_Id / DP_Key
CERT_DNS="dns_cf"

# DNS API 凭据。用 acme.sh 原生的变量名，按 CERT_DNS 选一组填：
#   dns_cf  →  CF_Token
#   dns_dp  →  DP_Id + DP_Key
# 只填当前 CERT_DNS 用到的那组，另一组留空或删掉都行。
CF_Token=""        # dns_cf：Cloudflare API Token（建议只授 Zone.DNS:Edit）
# DP_Id=""         # dns_dp：DNSPod 的 ID
# DP_Key=""        # dns_dp：DNSPod 的 Token

# ============ 可选 ============

# 账号邮箱，用于 CA 发送到期提醒
# CERT_EMAIL="you@your.domain"

# CA：letsencrypt | zerossl
# CERT_SERVER="letsencrypt"

# 证书到期前多少天开始尝试续期（1-89）
# Let's Encrypt 会通过 ARI 建议更合适的时机，这个值作为兜底
# CERT_DAYS="30"

# 密钥类型：ec-256 | ec-384 | ec-521 | 2048 | 3072 | 4096
# CERT_KEYLEN="ec-256"

# 部署开关（当前阶段保持 0，只验证签发）
# DO_DEPLOY="0"

# ============ 调试 ============

# 传给 acme.sh 的 --debug 级别（0-3），留空则不加
# 0 = 只打错误，3 = 最详细（含原始 HTTP 报文）
# ACME_DEBUG="2"

# 1 = dry-run：只打印将要执行的 acme.sh 命令，不实际调用 CA
# 用于确认参数拼接是否正确，不消耗配额
# SHELL_DEBUG="1"
